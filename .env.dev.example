# ===== 开发库：compose 里的 db 服务（MSSQL）=====
#
# 用法：  cp .env.dev.example .env.dev
#
# 为什么这个文件是**必填**的：docker-compose.yml 里 app / db / db-init 三个服务
# 都读它，且写成 required: true —— 缺了 compose 会立刻报错，而不是静默回落到
# sqlite 再在注册时抛一个和真实原因毫无关系的错。
#
# ⚠️ MSSQL_SA_PASSWORD 与 DB_PASSWORD 必须一致：
#    前者是 db 容器初始化 sa 账号时用的口令，后者是 app 连它时提供的口令。
#    tests_safe/test_docker_assets.py 里有断言盯着这两个值（以及 DATABASE_URL
#    里嵌的那个）相等 —— 改一个忘另一个会立刻测试报红。
#
# ⚠️ 这口令只保护一个**没发布到宿主**的本地容器，所以明文写死是可以的。
#    别把它当成任何意义上的生产凭据。

# 容器给 sa 账号设口令（MSSQL 官方镜像读这个变量）
MSSQL_SA_PASSWORD=LocalDevSql!2026

# DB_HOST 是 compose 网络里的**服务名**，不是 localhost；
# DB_PORT 是**容器内**的端口。1433 刻意没有发布到宿主（见 docker-compose.yml），
# 所以宿主上写 localhost:1433 是连不上的，别改。
DB_HOST=db
DB_PORT=1433
DB_USER=sa
DB_NAME=cscl_db

# —— 以下两个都是连接串/口令，动上面任何一项时记得同步 ——
DB_PASSWORD=LocalDevSql!2026
DATABASE_URL=mssql+pymssql://sa:LocalDevSql!2026@db:1433/cscl_db?charset=utf8
