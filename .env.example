# ============================================================================
# 配置模板。复制为 `.env` 并填入真实值。
#
# `.env` 已被 .gitignore 忽略（连同 `.env.<环境>` 覆盖层），**切勿提交**。
#
# 分环境：`APP_ENV=dev` 会让程序额外加载 `.env.dev` 作为**覆盖层**，
# 叠加在 `.env` 之上。优先级：进程环境变量 > `.env.<APP_ENV>` > `.env`。
#
# 本文件列出全仓库实际读取的全部键——代码新增键而漏写此处，
# tests_safe/test_env_docs.py 会红。标注 [默认] 的是不写也能跑的值；
# 标注 [机密] 的必须填且绝不能进仓库。
# ============================================================================

# ===== 运行环境 =====
APP_ENV=dev                          # 选哪个覆盖层；不设则 dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 数据库（阿里云 RDS SQL Server / MSSQL）=====
# **这 6 行留空是刻意的**：库指向按环境分层，放在覆盖层里，不放在基础层。
#   本机开发 → cp .env.dev.example  .env.dev    （连 compose 里的 db 容器）
#   线上部署 → cp .env.prod.example .env.prod   （连远程 RDS）
#
# 留空不是无害的默认值，而是一次**静默降级**：app/core/database.py 会回落到
# 本地 SQLite 并照常启动，直到某次操作才以别的症状暴露。docker-compose.yml
# 因此把 .env.dev 写成 required: true —— 缺了 compose 当场报错，不等你踩到。
#
# 两条路径读**不同**的变量，写覆盖层时必须两边都给：
#   app/core/database.py（ORM 侧）读 DATABASE_URL，留空则回退本地 SQLite
#   app/routers/auth.py 的 /api/register、/api/login（直连，不走 ORM）读 DB_*
# 格式: mssql+pymssql://<user>:<password>@<host>:1433/<db>?charset=utf8
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=                        # [机密]
DB_NAME=

# ===== LLM =====
# LLM_PROVIDER 决定其余项的默认值：deepseek 或 ollama
LLM_PROVIDER=deepseek
LLM_MODEL=                          # [默认] deepseek-chat（ollama 时 gemma4:e4b）
LLM_BASE_URL=                       # [默认] https://api.deepseek.com（ollama 时本机 11434）
LLM_API_KEY=                        # [机密]
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# 主 provider 故障时的降级通道
LLM_FALLBACK_ENABLED=               # [默认] provider 非 deepseek 时为 true
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-chat
LLM_FALLBACK_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_API_KEY=               # [机密]

# ===== 阿里云 NLS 语音识别 =====
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=           # [机密]
ALIYUN_APP_KEY=

# ===== 阿里云 OSS（与 NLS 同一对 AccessKey）=====
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=              # [机密]
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_DOMAIN=                         # [默认] 由 bucket + endpoint 拼出
OSS_VIDEO_PREFIX=video_chunks/
OSS_SNAPSHOT_PREFIX=snapshots/

# ===== Agora RTC =====
# App ID 本身非机密；真正机密的是 App Certificate
AGORA_APP_ID=
AGORA_AUTH_MODE=appid
AGORA_APP_CERTIFICATE=              # [机密]

# ===== 阿里云 facebody 表情识别（已弃用）=====
# 当前没有任何活代码读取这两个键；以启用态列在这里会让部署者白填，故注释掉。
# 需要恢复该功能时，取消下面两行注释即可。
# ALIYUN_FACE_ACCESS_KEY_ID=
# ALIYUN_FACE_ACCESS_KEY_SECRET=      # [机密]

# ===== 研究增强模块（可选；不启用则全部留空）=====
RESEARCH_DEPLOYMENT_PROFILE=standard   # standard | enhanced
RESEARCH_MODULES_ENABLED=              # [默认] profile=enhanced 时为 true
RESEARCH_RUNTIME_MODE=                 # [默认] enhanced 时 enhanced_strict，否则 documented_only
RESEARCH_MODEL_ROOT=                   # [默认] storage/research_models
RESEARCH_GALLERY_ROOT=                 # [默认] storage/research_gallery
RESEARCH_CACHE_ROOT=                   # [默认] storage/research_runtime_cache
RESEARCH_MODEL_SOURCE=manual_local
RESEARCH_AUTO_DOWNLOAD_MODELS=false    # 置 true 会在启动时联网拉模型，谨慎

# 模型标识（一般不用改）
RESEARCH_PYANNOTE_MODEL_ID=pyannote/speaker-diarization-3.1
RESEARCH_WESPEAKER_MODEL_NAME=chinese
RESEARCH_CLIP_MODEL_ID=openai/clip-vit-base-patch16
RESEARCH_BGE_MODEL_ID=BAAI/bge-m3
RESEARCH_WESPEAKER_REPO_URL=https://github.com/wenet-e2e/wespeaker.git
RESEARCH_TALKNET_REPO_URL=https://github.com/TaoRuijie/TalkNet-ASD.git

# 增强模块用的独立解释器；不设则用当前进程的解释器
RESEARCH_ENHANCED_PYTHON=
# HuggingFace 令牌。变量名是 **RESEARCH_HF_TOKEN**（注意前缀）。
RESEARCH_HF_TOKEN=                  # [机密]
