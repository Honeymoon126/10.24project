# ===== 线上库：阿里云 RDS SQL Server（MSSQL）=====
#
# 用法：  cp .env.prod.example .env.prod    然后把占位符换成真实凭据。
#
# 这一层由 APP_ENV=prod 选中。app/core/config.py 的 _load_dotenv 优先级是
#   进程环境变量  >  .env.<APP_ENV>  >  .env
# 所以线上只要进程里设了 APP_ENV=prod，就会用本文件覆盖 .env 里的同名键。
#
# 六个都要填：ORM 读 DATABASE_URL，而 /api/register 与 /api/login **不走 ORM**，
# 它们直接 pymssql.connect(DB_HOST, DB_PORT, ...)，**完全不读 DATABASE_URL**
# （见 app/routers/auth.py 的文件头）。只填 DATABASE_URL 的话，这两条路由会连到
# 一个不存在的地方，表现为注册失败。
#
# ⚠️ 本文件是**模板，只能放占位符**。真实凭据写进 .env.prod（已被 gitignore）。
#    tests_safe/test_docker_assets.py 有断言：仓库里任何**入库**文件都不得含
#    生产主机名或口令。

DB_HOST=<生产 RDS 主机名>
DB_PORT=<端口；阿里云 RDS SQL Server 常见为 3433>
DB_USER=<用户名>
DB_PASSWORD=<口令>
DB_NAME=<库名>

# charset=utf8 不能省：中文内容靠它
DATABASE_URL=mssql+pymssql://<用户名>:<口令>@<主机>:<端口>/<库名>?charset=utf8

# —— 线上部署还要建库/对齐结构时，用同一份脚本（生产开发通用）：
#      sqlcmd -S <主机>,<端口> -U <用户名> -P <口令> -d <库名> -C -i db/schema.sql
#    对已有库执行是**无操作**（每条语句都幂等）。详见 deploy/README.md。
